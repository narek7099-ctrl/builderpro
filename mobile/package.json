{
  "name": "builderpro-app",
  "version": "1.0.0",
  "private": true,
  "description": "BuilderPro for iPhone, iPad, Mac (Apple Silicon) and Android: a native shell around builderpro-os.com",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#ffffff' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#0c111d'",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "cap sync android && cd android && ./gradlew bundleRelease",
    "ios:open": "cap sync ios && cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
